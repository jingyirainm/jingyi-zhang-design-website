<!doctype html><html><head><meta charset="utf-8">
<title>Vibe Painting — product tile</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;1,400;1,600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:810px;height:1080px;overflow:hidden;background:#070b14}
.tile{position:relative;width:810px;height:1080px;overflow:hidden;
  background:linear-gradient(180deg,#05080f 0%,#0d1628 16%,#23324f 34%,#56657f 50%,#a3adbd 64%,#dfe3e9 76%,#f4f5f7 86%,#fafafa 100%)}
.spot{position:absolute;left:50%;top:44%;width:900px;height:760px;margin:-380px 0 0 -450px;border-radius:50%;
  background:radial-gradient(closest-side,rgba(190,205,235,.28),rgba(190,205,235,0));pointer-events:none}
.grain{position:absolute;inset:0;opacity:.06;mix-blend-mode:overlay;pointer-events:none;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
.shadow{position:absolute;left:50%;top:902px;width:360px;height:46px;margin-left:-180px;border-radius:50%;
  background:radial-gradient(closest-side,rgba(10,16,30,.42),rgba(10,16,30,0));filter:blur(6px)}
.scene{position:absolute;inset:0;perspective:2000px}
.mon{position:absolute;left:170px;top:130px;width:470px;transform-style:preserve-3d;will-change:transform}
.bezel{position:relative;background:#121315;padding:9px;border-radius:12px;
  box-shadow:0 0 0 1px #2c2d31 inset,0 50px 80px -30px rgba(5,10,25,.65)}
.rim{position:absolute;inset:-1px;border-radius:13px;pointer-events:none;
  background:linear-gradient(100deg,rgba(255,255,255,.55),rgba(255,255,255,0) 18%,rgba(255,255,255,0) 82%,rgba(255,255,255,.25));
  -webkit-mask:linear-gradient(#000,#000) content-box,linear-gradient(#000,#000);-webkit-mask-composite:xor;mask-composite:exclude;padding:1.2px}
.screen{position:relative;width:452px;height:603px;overflow:hidden;background:#FDF5F7;border-radius:3px}
canvas{position:absolute;inset:0;width:100%;height:100%}
.glare{position:absolute;inset:-40%;pointer-events:none;mix-blend-mode:screen;
  background:linear-gradient(115deg,rgba(255,255,255,0) 42%,rgba(255,255,255,.22) 48%,rgba(255,255,255,0) 54%);will-change:transform}
.neck{position:absolute;left:50%;margin-left:-28px;top:620px;width:56px;height:150px;
  background:linear-gradient(90deg,#8d939c,#dfe3e8 40%,#f4f6f8 52%,#aab0b8)}
.base{position:absolute;left:50%;margin-left:-118px;top:762px;width:236px;height:14px;border-radius:50%/60%;
  background:linear-gradient(#f3f4f6,#bfc4cb);box-shadow:0 8px 16px -6px rgba(10,16,30,.35)}
/* poster overlay — mirrors the app's layout */
.ov{position:absolute;inset:4%;display:flex;flex-direction:column;justify-content:space-between;color:#111;font-family:Cormorant,serif;pointer-events:none}
.top{font-size:9.5px;letter-spacing:.15em;opacity:.5;line-height:1.5;max-width:82%}
.bot{display:flex;justify-content:space-between;align-items:flex-end}
.cam{width:74px;aspect-ratio:3/4;border:1px solid #D4B5D866;background:#e9e9e9ee;position:relative;overflow:hidden;box-shadow:0 10px 24px -10px rgba(0,0,0,.35)}
.cam svg{position:absolute;inset:0;width:100%;height:100%}
.cam::after{content:'';position:absolute;inset:0;background-image:radial-gradient(circle,#000 .3px,transparent .3px);background-size:2px 2px;opacity:.25}
.sig{text-align:right}
.sig .nm{font-size:40px;line-height:.6;opacity:.6;transform:rotate(-2deg);transform-origin:bottom right;white-space:nowrap}
.sig .cr{font-family:'JetBrains Mono',monospace;font-size:5px;letter-spacing:.4em;text-transform:uppercase;opacity:.25;margin-top:14px}
.hints{position:absolute;left:4%;bottom:21%;font-family:Cormorant,serif;font-style:italic;font-size:12.5px;line-height:1.4;color:#111}
.hints div{transition:opacity .35s,transform .35s;opacity:.4}
.hints div.on{opacity:1;transform:translateX(4px);font-weight:600}
.finger{position:absolute;width:16px;height:16px;margin:-8px 0 0 -8px;border-radius:50%;border:1.5px solid rgba(17,17,17,.55);background:rgba(255,255,255,.35);box-shadow:0 0 0 5px rgba(255,255,255,.18)}
.save{position:absolute;right:4%;top:4%;font-family:Cormorant,serif;font-style:italic;font-size:10px;letter-spacing:.1em;padding:4px 10px;border:1px solid rgba(0,0,0,.12);border-radius:99px;background:rgba(255,255,255,.35);color:#111}
</style></head><body>
<div class="tile"><div class="spot"></div><div class="shadow" id="shadow"></div>
<div class="scene"><div class="mon" id="mon">
  <div class="bezel"><div class="rim"></div><div class="screen">
    <canvas id="cv"></canvas>
    <div class="ov">
      <div class="top">I am thinking (you) at (New York) on (<span id="dt"></span>)</div>
      <div class="bot">
        <div class="cam"><svg viewBox="0 0 60 80" fill="none" stroke="#222" stroke-width="1.1" stroke-linecap="round">
          <path d="M30 14c-11 0-17 8-17 20 0 13 8 24 17 24s17-11 17-24c0-12-6-20-17-20z" opacity=".75"/>
          <path id="eyeL" d="M22 33q3-2.5 6 0q-3 2.5-6 0z"/><path id="eyeR" d="M32 33q3-2.5 6 0q-3 2.5-6 0z"/>
          <path d="M30 37v6l-2 1" opacity=".6"/>
          <ellipse id="mouth" cx="30" cy="49" rx="4" ry=".8"/>
          <path d="M18 64c4-3 8-4 12-4s8 1 12 4" opacity=".5"/>
        </svg></div>
        <div class="sig"><div class="nm">Jingyi</div><div class="cr">Created by Rainmelon Studio</div></div>
      </div>
    </div>
    <div class="hints"><div id="h0">blow → add color</div><div id="h1">blink → add figure</div><div id="h2">finger → blend</div></div>
    <div class="save">finish &amp; save</div>
    <div class="finger" id="finger" style="opacity:0"></div>
    <div class="glare" id="glare"></div>
  </div></div>
  <div class="neck"></div><div class="base"></div>
</div></div>
<div class="grain"></div>
</div>
<script>
// ---- Ebru marbling, ported from the app's MarblingCanvas ----
const W=452,H=603,NR=120,DPR=Math.max(2,devicePixelRatio||1), cv=document.getElementById('cv'), ctx=cv.getContext('2d');
cv.width=W*DPR; cv.height=H*DPR;
const BG='#FDF5F7', COLORS=['#C79BD0','#97B4CC','#E2B3CF','#E6B5A2','#A99BDB','#9CCAC4'];
var drops=[], stars=[], ci=0, cycle=0;
const next=()=>COLORS[(ci++)%COLORS.length];
let seed=7; const rnd=()=>(seed=(seed*16807)%2147483647)/2147483647;   // deterministic, so every loop reads the same
function displace(t,cx,cy,r){const dx=t.x-cx,dy=t.y-cy,d2=dx*dx+dy*dy;if(!d2)return;const s=Math.sqrt(1+r*r/d2);t.x=cx+dx*s;t.y=cy+dy*s;}
function addDrop(x,y,r,color){drops.forEach(d=>{displace(d.center,x,y,r);d.points.forEach(p=>displace(p,x,y,r));});
  const pts=[];for(let i=0;i<NR;i++){const a=i/NR*Math.PI*2;pts.push({x:x+Math.cos(a)*r,y:y+Math.sin(a)*r});}
  drops.push({points:pts,color,center:{x,y},radius:r}); if(drops.length>26)drops.shift();}
function tine(p1,p2,z,mu){const dx=p2.x-p1.x,dy=p2.y-p1.y,L=Math.hypot(dx,dy);if(L<.5)return;const ux=dx/L,uy=dy/L;
  const f=p=>{const vx=p.x-p1.x,vy=p.y-p1.y,pr=Math.max(0,Math.min(L,vx*ux+vy*uy)),cx=p1.x+pr*ux,cy=p1.y+pr*uy;const s=z*Math.pow(2,-Math.hypot(p.x-cx,p.y-cy)/mu);p.x+=ux*s;p.y+=uy*s;};
  drops.forEach(d=>{d.points.forEach(f);f(d.center);});}
function spawnStars(x,y){for(let i=0;i<3;i++){const a=rnd()*Math.PI*2,s=.8+rnd()*2;stars.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,size:10+rnd()*10,life:1,ph:rnd()*6});}}
function starPath(x,y,r){ctx.beginPath();for(let i=0;i<8;i++){const a=i*Math.PI/4,rr=i%2?r*.28:r;ctx.lineTo(x+Math.cos(a)*rr,y+Math.sin(a)*rr);}ctx.closePath();}
function simTick(){
  drops.forEach(d=>{const n=d.points.length;d.points=d.points.map((p,i)=>{const a=d.points[(i-1+n)%n],b=d.points[(i+1)%n],sx=(a.x+b.x)/2,sy=(a.y+b.y)/2,dx=p.x-d.center.x,dy=p.y-d.center.y,dist=Math.hypot(dx,dy),k=dist?d.radius/dist:1;
    return{x:p.x+(sx-p.x)*.015+(d.center.x+dx*k-p.x)*.003,y:p.y+(sy-p.y)*.015+(d.center.y+dy*k-p.y)*.003};});});
  stars.forEach(s=>{s.vx*=.98;s.vy*=.98;s.x+=s.vx;s.y+=s.vy;s.life-=.006;}); stars=stars.filter(s=>s.life>0);
}
function paint(t,fade){
  ctx.setTransform(DPR,0,0,DPR,0,0); ctx.fillStyle=BG; ctx.fillRect(0,0,W,H);
  const poly=d=>{ctx.beginPath();ctx.moveTo(d.points[0].x,d.points[0].y);for(let i=1;i<d.points.length;i++)ctx.lineTo(d.points[i].x,d.points[i].y);ctx.closePath();};
  ctx.save();ctx.filter='blur(14px)';drops.forEach(d=>{poly(d);ctx.globalAlpha=.45*fade;ctx.fillStyle=d.color;ctx.fill();});ctx.restore();
  ctx.save();ctx.filter='blur(3px)';ctx.globalAlpha=.78*fade;drops.forEach(d=>{poly(d);ctx.fillStyle=d.color;ctx.fill();});ctx.restore();
  stars.forEach(s=>{ctx.save();ctx.globalAlpha=Math.min(1,s.life*1.4)*.8*fade;ctx.fillStyle='#111';starPath(s.x,s.y,s.size*(.85+.15*Math.sin(t/300+s.ph)));ctx.fill();ctx.restore();});
}
// ---- scripted performance (13 s loop) + product motion ----
const LOOP=13000, $=id=>document.getElementById(id);
const mon=$('mon'), glare=$('glare'), shadow=$('shadow'), fing=$('finger'), mouth=$('mouth'), eL=$('eyeL'), eR=$('eyeR');
const blowAt=[400,1900,3600,5400,8400], blinkAt=[3000,7200,10300];
const ease=x=>x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2;
var t=0, done=new Set(), last=null, acc=0;
const BASE_DATE=new Date();
function events(){
  blowAt.forEach((bt,k)=>{ if(t>=bt&&!done.has('b'+k)){done.add('b'+k);
    const x=W*(.36+((k*37+cycle*13)%30)/100),y=H*(.3+((k*23+cycle*7)%34)/100),r=W*(.11+(k%3)*.04);
    for(let i=0;i<2+(k%2);i++)addDrop(x+(rnd()-.5)*40,y+(rnd()-.5)*40,r*(.6+rnd()*.5),next()); }});
  blinkAt.forEach((bt,k)=>{ if(t>=bt&&!done.has('k'+k)){done.add('k'+k); spawnStars(W*.42,H*.36); spawnStars(W*.58,H*.36); }});
}
function ui(){
  const since=a=>a.map(x=>t-x).filter(d=>d>=0).sort((a,b)=>a-b)[0] ?? 1e9;
  const sb=since(blowAt), sk=since(blinkAt);
  const stir=(t>4300&&t<7000)||(t>9100&&t<12300);
  mouth.setAttribute('ry', sb<520 ? 4.2 : .8);
  [eL,eR].forEach(e=> sk<260 ? e.setAttribute('transform','translate(0 33) scale(1 .1) translate(0 -33)') : e.removeAttribute('transform'));
  const active = stir ? 2 : (sk<sb ? 1 : 0);
  ['h0','h1','h2'].forEach((h,j)=>$(h).classList.toggle('on', j===active));
  fing.style.opacity = stir ? 1 : 0;
  // product motion: slow turntable sway, breathing float, sweeping glare, shadow follows
  const p=t/LOOP, s=Math.sin(p*Math.PI*2), c=Math.cos(p*Math.PI*2);
  mon.style.transform=`translate3d(0,${(-6*c).toFixed(2)}px,0) rotateY(${(-13+7*s).toFixed(3)}deg) rotateX(${(2.2+1.2*c).toFixed(3)}deg)`;
  shadow.style.transform=`translateX(${(-14*s).toFixed(1)}px) scale(${(1+.05*c).toFixed(3)},1)`;
  const g=((t%6500)/6500); glare.style.transform=`translateX(${(-60+120*ease(g)).toFixed(1)}%)`; glare.style.opacity=(Math.sin(g*Math.PI)).toFixed(3);
  $('dt').textContent=new Date(BASE_DATE.getTime()+t).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
}
function advance(dt){              // fixed 60 Hz simulation steps; one paint per call
  acc+=dt;
  while(acc>=1000/60){ acc-=1000/60; t+=1000/60;
    if(t>=LOOP){ t-=LOOP; drops=[]; stars=[]; done.clear(); last=null; cycle++; seed=7; ci=0; }
    events();
    const stir=(t>4300&&t<7000)||(t>9100&&t<12300);
    if(stir){ const u=t/700, x=W*(.5+.32*Math.sin(u)), y=H*(.46+.22*Math.sin(u*1.7+1)); fing.style.left=x+'px'; fing.style.top=y+'px'; if(last) tine(last,{x,y},18,50); last={x,y}; } else last=null;
    simTick();
  }
  const fade = t>12200 ? Math.max(0,1-(t-12200)/700) : (t<250 ? t/250 : 1);
  paint(t,fade); ui();
}
window.advance=advance;
if(!location.hash.includes('manual')){ let prev=performance.now(); (function loop(now){ advance(Math.min(64,now-prev)); prev=now; requestAnimationFrame(loop); })(prev); }
else { advance(0); }
</script></body></html>
