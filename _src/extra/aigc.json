able\" hash=\"J3177676140181391843930749074942\" loop=\"true\" muted=\"true\"></media-item><media-item class=\"zoomable\" hash=\"R3177673362267755039935661669886\"></media-item><media-item class=\"zoomable\" hash=\"F3177677388712370984814331100670\"></media-item></gallery-grid><br />\n<br />\n<span class=\"wenshi\"><b>INTRODUCTION</b><br />\n<br />\nProduct-focused key visuals that place objects in staged, cinematic scenes, from material and lighting studies to campaign-style shots. With AIGC I can prototype hero images, launch visuals and marketing assets early in a project, so product and brand teams can align on the look before investing in a photo shoot or 3D production.</span><br />\n<br />\n", "local_css": "[id=\"AIGCSEL0003\"].page {\n\tjustify-content: flex-end;\n}\n\n[id=\"AIGCSEL0003\"] .page-layout {\n\tmax-width: 68%;\n\tpadding: 2rem;\n}", "media": [{"hash": "F2954326764866209692089940508158", "name": "3.png", "display_name": "3.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "P2954326764847762948016230956542", "name": "2.png", "display_name": "2.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "Z2954326883165179436789295021566", "name": "rainmelonzjy_72706_httpss.mj.runvUu2RMeorMM_httpss.mj.runP85F7B_ad4c4ff9-d4ce-42b7-a65d-c82c82229cf7-copy.png", "display_name": "rainmelonzjy_72706_httpss.mj.runvUu2RMeorMM_httpss.mj.runP85F7B_ad4c4ff9-d4ce-42b7-a65d-c82c82229cf7-copy.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "R3177673362267755039935661669886", "name": "rainmelonzjy_72706_httpss.mj.runa9q8-d6hrVo_httpss.mj.runRGna_af0888dc-b765-49c1-9bdd-3ded4e989d00_1.png", "display_name": "rainmelonzjy_72706_httpss.mj.runa9q8-d6hrVo_httpss.mj.runRGna_af0888dc-b765-49c1-9bdd-3ded4e989d00_1.png", "width": 928, "height": 1232, "is_video": false, "is_image": true}, {"hash": "J3177676140181391843930749074942", "name": "rainmelonzjy_72706_put_the_cake_on_the_tab