7214120484350\"></media-item><media-item class=\"zoomable\" hash=\"V3177697640507245794992991829502\"></media-item><media-item class=\"zoomable\" hash=\"Q3177697640470352306845572726270\"></media-item><media-item class=\"zoomable\" hash=\"M3177697640488799050919282277886\"></media-item><media-item class=\"zoomable\" hash=\"S3177697640451905562771863174654\"></media-item></gallery-grid><br />\n<br />\n<span class=\"wenshi\"><b>INTRODUCTION</b><br />\n<br />\nAI-generated fashion imagery that explores styling, materials and mood for a cohesive editorial look. I use generative tools as a fast art-direction sandbox: exploring many looks, keeping the strongest, and refining them into brand-ready visuals. In product work, this lets me build mood boards and campaign concepts quickly to support brand design.</span><br />\n<br />\n", "local_css": "[id=\"AIGCSEL0002\"].page {\n\tjustify-content: flex-end;\n}\n\n[id=\"AIGCSEL0002\"] .page-layout {\n\tpadding: 2rem;\n\tmax-width: 68%;\n}", "media": [{"hash": "P2954319283161961300675157884414", "name": "4.png", "display_name": "4.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "E3177695904355033809671122386430", "name": "rainmelonzjy_72706_httpss.mj.runhteelTTc5lk_httpss.mj.runspD94W_a4841646-9de8-4f03-80fa-d71c19a6c294-1.png", "display_name": "rainmelonzjy_72706_httpss.mj.runhteelTTc5lk_httpss.mj.runspD94W_a4841646-9de8-4f03-80fa-d71c19a6c294-1.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "N3177696389449062716011201232382", "name": "rainmelonzjy_72706_httpss.mj.runhteelTTc5lk_httpss.mj.runZK7nAK_2b08cdbe-7109-40a3-967a-3993016e16a1-4.png", "display_name": "rainmelonzjy_72706_httpss.mj.runhteelTTc5lk_httpss.mj.runZK7nAK_2b08cdbe-7109-40a3-967a-3993016e16a1-4.png", "width": 1856, "height": 2464, "is_video": false, "is_image": true}, {"hash": "Q3177697640470352306845572726270", "name": "rainmelonzjy_72706_httpss.mj.runM-Jt6StUtGA_httpss.mj.runx5IPHs_9d755fc